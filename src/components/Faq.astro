---
const { items }: { items: { q: string; a: string }[] } = Astro.props;
---
<section class="my-10" aria-labelledby="faq-h">
  <h2 id="faq-h" class="text-xl font-extrabold text-teal mb-4">پرسش‌های پرتکرار</h2>
  <div class="space-y-3">
    {items.map((f, i) => (
      <details class="card p-4" open={i === 0}>
        <summary class="flex justify-between gap-4"><span>{f.q}</span><span class="plus text-pom text-2xl leading-none" aria-hidden="true">+</span></summary>
        <p class="mt-3 text-[.98rem]">{f.a}</p>
      </details>
    ))}
  </div>
</section>

---
import Tool from '../../layouts/Tool.astro';
const faq = [
  { q: 'نوزاد در هر وعده چقدر شیر خشک بخورد؟', a: 'به‌عنوان یک قاعدهٔ تقریبی رایج، نوزاد سالم ترم در ماه‌های اول روزانه حدود ۱۵۰ میلی‌لیتر شیر به ازای هر کیلوگرم وزن نیاز دارد که بین وعده‌ها تقسیم می‌شود. نیاز هر نوزاد متفاوت است و نشانه‌های گرسنگی و سیری او مهم‌تر از عدد است.' },
  { q: 'چند وعده در روز؟', a: 'نوزادان تازه متولد معمولاً هر ۲ تا ۳ ساعت (۸ وعده یا بیشتر در شبانه‌روز) می‌خورند و با بزرگ‌تر شدن، تعداد وعده‌ها کمتر و حجم هر وعده بیشتر می‌شود.' },
  { q: 'از کجا بفهمم نوزاد سیر شده است؟', a: 'رها کردن سرشیشه، برگرداندن سر، آرام شدن دست‌ها و خواب‌آلودگی نشانه‌های سیری هستند. نوزاد را مجبور به تمام کردن شیشه نکنید. خیس شدن منظم پوشک و وزن‌گیری مناسب نشانهٔ کافی بودن تغذیه است.' },
  { q: 'آیا بعد از ۶ ماهگی هم همین محاسبه درست است؟', a: 'بعد از ۶ ماهگی غذای کمکی شروع می‌شود و نیاز به شیر به‌تدریج تغییر می‌کند. ابزار برای این سن یک بازهٔ تقریبی نشان می‌دهد؛ برنامهٔ دقیق را با پزشک یا کارشناس تغذیه تنظیم کنید.' },
  { q: 'شیر مادر بهتر است یا شیر خشک؟', a: 'سازمان جهانی بهداشت تغذیهٔ انحصاری با شیر مادر را تا ۶ ماهگی توصیه می‌کند. اگر به هر دلیلی از شیر خشک استفاده می‌کنید، نوع شیر خشک را با نظر پزشک انتخاب کنید و دستور تهیهٔ روی قوطی را دقیق رعایت کنید.' },
];
const howto = [
  'سن نوزاد (به هفته یا ماه) و وزن فعلی او را وارد کنید.',
  'نیاز روزانه = وزن (کیلوگرم) × حدود ۱۵۰ میلی‌لیتر، با سقف تقریبی ۹۶۰ میلی‌لیتر در روز.',
  'تعداد معمول وعده‌ها بر اساس سن تعیین و حجم هر وعده محاسبه می‌شود.',
  'نتیجه به‌صورت بازه (۱۰٪ کمتر و بیشتر) نمایش داده می‌شود چون نیاز هر نوزاد متفاوت است.',
];
---
<Tool slug="formula-amount" icon="formula" category="HealthApplication" title="محاسبه مقدار شیر خشک نوزاد در هر وعده" description="ماشین‌حساب رایگان مقدار شیر خشک: بر اساس وزن و سن نوزاد، حجم تقریبی شیر روزانه، تعداد وعده‌ها و مقدار هر وعده را ببینید." h1="محاسبه مقدار شیر خشک نوزاد" intro="وزن و سن نوزاد را وارد کنید تا حجم تقریبی شیر خشک در شبانه‌روز و در هر وعده را ببینید." faq={faq} howto={howto}
  products={[
    { name: 'شیشه شیر ضد نفخ', query: 'شیشه شیر ضد نفخ', note: 'سرشیشهٔ متناسب با سن نوزاد انتخاب کنید.' },
    { name: 'دستگاه استریل و گرم‌کن شیشه شیر', query: 'استریل کننده شیشه شیر', note: 'برای تمیز نگه داشتن وسایل تغذیه.' },
    { name: 'ظرف تقسیم‌بندی شیر خشک', query: 'ظرف نگهداری شیر خشک', note: 'برای بیرون از خانه؛ نوع شیر خشک را پزشک تعیین می‌کند.' },
  ]}
  related={[
    { href: '/blog/formula-feeding-amount-by-age/', label: 'جدول مقدار شیر خشک نوزاد بر اساس سن' },
    { href: '/blog/how-to-prepare-formula/', label: 'طرز تهیهٔ شیر خشک و استریل شیشه' },
    { href: '/tools/growth-percentile/', label: 'محاسبه صدک رشد کودک' },
    { href: '/blog/starting-solid-foods/', label: 'شروع غذای کمکی' },
  ]}>
  <div class="grid gap-6 md:grid-cols-2">
    <form class="space-y-4" onsubmit="return false">
      <div class="grid grid-cols-2 gap-3">
        <div class="field"><label for="age">سن</label><input id="age" inputmode="decimal" value="۲" /></div>
        <div class="field"><label for="unit">واحد</label><select id="unit"><option value="m">ماه</option><option value="w">هفته</option></select></div>
      </div>
      <div class="field"><label for="w">وزن نوزاد (کیلوگرم)</label><input id="w" inputmode="decimal" placeholder="مثلاً ۵٫۲" /></div>
      <button class="btn" id="go" type="button">محاسبه کن</button>
    </form>
    <div id="out" class="result" aria-live="polite"><p class="text-muted">نتیجه اینجا نمایش داده می‌شود.</p></div>
  </div>
  <Fragment slot="interpret">
    <p>عدد نهایی یک <strong>نقطهٔ شروع</strong> است، نه دستور. بعضی نوزادان کمی کمتر و بعضی کمی بیشتر می‌خورند. به نشانه‌های گرسنگی (مکیدن دست، چرخاندن سر به دنبال شیر) و سیری توجه کنید. اگر نوزاد مدام استفراغ می‌کند، کمتر از حد معمول پوشک خیس می‌کند یا وزن نمی‌گیرد، با پزشک تماس بگیرید.</p>
    <p>برای جدول کامل‌تر، <a href="/blog/formula-feeding-amount-by-age/">مقدار شیر خشک بر اساس سن</a> را ببینید.</p>
  </Fragment>
  <Fragment slot="how"><p>مقدار حدود ۱۵۰ میلی‌لیتر به ازای هر کیلوگرم در روز، تقریبی است که در بسیاری از راهنماهای تغذیهٔ نوزاد برای ماه‌های اول به کار می‌رود؛ همچنین راهنماها معمولاً اشاره می‌کنند که نوزادان به‌ندرت به بیش از حدود ۹۶۰ میلی‌لیتر (۳۲ اونس) شیر خشک در روز نیاز دارند.</p></Fragment>
</Tool>
<script>
  import { num, faN } from '../../lib/jalali-select';
  document.getElementById('go')!.onclick = () => {
    const out = document.getElementById('out')!;
    const a = num(document.getElementById('age') as HTMLInputElement);
    const unit = (document.getElementById('unit') as HTMLSelectElement).value;
    const w = num(document.getElementById('w') as HTMLInputElement);
    if (!(a >= 0) || !(w >= 1.5 && w <= 15)) { out.innerHTML = '<p>لطفاً سن و وزن معتبر (۱٫۵ تا ۱۵ کیلوگرم) وارد کنید.</p>'; return; }
    const m = unit === 'w' ? a / 4.345 : a;
    if (m > 12) { out.innerHTML = '<p>این ابزار برای زیر یک سال است. بعد از یک سالگی برنامهٔ غذایی را با پزشک کودک تنظیم کنید.</p>'; return; }
    if (unit === 'w' ? a < 1 : m < 0.25) { out.innerHTML = '<p>در هفتهٔ اول تولد، حجم معدهٔ نوزاد بسیار کوچک است و مقدار هر وعده روز به روز افزایش می‌یابد. در این دوره طبق دستور پزشک یا مامای بیمارستان عمل کنید.</p>'; return; }
    const feeds = m < 1 ? 8 : m < 2 ? 7 : m < 4 ? 6 : m < 6 ? 5 : 4;
    let daily = Math.min(960, w * 150);
    let note = '';
    if (m >= 6) { daily = Math.min(daily, 900); note = '<p class="text-sm mt-2">در این سن غذای کمکی هم شروع شده است و نیاز به شیر با مقدار غذای جامد تغییر می‌کند.</p>'; }
    const per = daily / feeds;
    const r = (x: number) => Math.round(x / 5) * 5;
    out.innerHTML = `<p class="text-sm text-muted">مقدار تقریبی هر وعده</p><p class="stat">${faN(r(per * 0.9))} تا ${faN(r(per * 1.1))} میلی‌لیتر</p>
      <p class="mt-2">حدود <strong>${faN(feeds)} وعده</strong> در شبانه‌روز · مجموع روزانه حدود <strong>${faN(r(daily))} میلی‌لیتر</strong></p>
      <p class="text-sm mt-2">≈ ${faN(per / 30, 1)} اونس در هر وعده</p>${note}`;
  };
</script>

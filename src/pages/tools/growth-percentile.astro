---
import Tool from '../../layouts/Tool.astro';
import JDate from '../../components/JDate.astro';
const faq = [
  { q: 'صدک رشد یعنی چه؟', a: 'صدک نشان می‌دهد اندازهٔ کودک شما در مقایسه با ۱۰۰ کودک هم‌سن و هم‌جنس سالم در کجا قرار می‌گیرد. صدک ۴۰ وزن یعنی حدود ۴۰ درصد کودکان هم‌سن وزن کمتری دارند. صدک بالا یا پایین به‌تنهایی به معنی بیماری نیست.' },
  { q: 'چه صدکی طبیعی است؟', a: 'در نمودارهای WHO معمولاً محدودهٔ بین صدک ۳ و ۹۷ (تقریباً منفی ۲ تا مثبت ۲ انحراف معیار) محدودهٔ مورد انتظار در نظر گرفته می‌شود. مهم‌تر از یک عدد، روند رشد در طول زمان است.' },
  { q: 'چرا ابزار فقط تا ۲۴ ماهگی است؟', a: 'این نسخه از جدول‌های رسمی وزن برای سن و قد خوابیده برای سن استاندارد رشد WHO برای تولد تا ۲۴ ماهگی استفاده می‌کند. بعد از دو سالگی قد معمولاً ایستاده اندازه‌گیری می‌شود و جدول جداگانه‌ای دارد.' },
  { q: 'برای نوزاد نارس چه کنم؟', a: 'برای نوزادان نارس معمولاً از «سن اصلاح‌شده» (سن تقویمی منهای هفته‌هایی که زودتر به دنیا آمده) استفاده می‌شود. ارزیابی رشد نوزاد نارس را حتماً با پزشک انجام دهید.' },
  { q: 'وزن کودکم از یک صدک به صدک دیگر رفته، نگران باشم؟', a: 'نوسان‌های کوچک طبیعی است. اما عبور از دو خط صدک اصلی (مثلاً از ۵۰ به زیر ۱۵) یا توقف وزن‌گیری باید با پزشک کودک بررسی شود.' },
];
const howto = [
  'جنس کودک، تاریخ تولد شمسی (یا سن به ماه)، وزن و قد را وارد کنید.',
  'سن دقیق به ماه محاسبه و پارامترهای L، M و S جدول WHO برای آن سن درون‌یابی می‌شوند.',
  'امتیاز Z با فرمول LMS محاسبه می‌شود: Z = ((X/M)^L − 1) / (L × S).',
  'امتیاز Z با توزیع نرمال استاندارد به صدک تبدیل می‌شود.',
];
---
<Tool slug="growth-percentile" icon="growth" title="محاسبه صدک رشد کودک: وزن و قد (WHO)" description="محاسبه رایگان صدک وزن و قد کودک بر اساس استاندارد رشد سازمان جهانی بهداشت (WHO) از تولد تا ۲۴ ماهگی، با تاریخ تولد شمسی." h1="محاسبه صدک رشد کودک (وزن و قد برای سن)" intro="وزن و قد کودک را وارد کنید تا صدک و امتیاز Z او بر اساس استاندارد رشد WHO برای تولد تا ۲ سالگی محاسبه شود." faq={faq} howto={howto}
  products={[
    { name: 'ترازوی دیجیتال نوزاد', query: 'ترازو نوزاد', note: 'برای پیگیری وزن بین ویزیت‌ها؛ ملاک اصلی، وزن‌کشی مرکز بهداشت است.' },
    { name: 'قدسنج کودک', query: 'قد سنج کودک', note: 'متر دیواری یا قدسنج نوزاد.' },
    { name: 'دفترچهٔ رشد و خاطرات کودک', query: 'دفتر خاطرات نوزاد', note: 'ثبت اندازه‌ها و اولین‌ها.' },
  ]}
  related={[
    { href: '/blog/baby-weight-height-chart/', label: 'جدول وزن و قد نوزاد تا ۲ سالگی' },
    { href: '/blog/growth-percentile-explained/', label: 'صدک رشد چیست و چطور تفسیرش کنیم؟' },
    { href: '/tools/formula-amount/', label: 'محاسبه مقدار شیر خشک' },
    { href: '/blog/starting-solid-foods/', label: 'شروع غذای کمکی' },
  ]}>
  <div class="grid gap-6 md:grid-cols-2">
    <form class="space-y-4" onsubmit="return false">
      <div class="field"><label for="sex">جنس کودک</label><select id="sex"><option value="girls">دختر</option><option value="boys">پسر</option></select></div>
      <JDate id="jd" label="تاریخ تولد (شمسی)" />
      <div class="grid grid-cols-2 gap-3">
        <div class="field"><label for="w">وزن (کیلوگرم)</label><input id="w" inputmode="decimal" placeholder="مثلاً ۷٫۵" /></div>
        <div class="field"><label for="h">قد (سانتی‌متر)</label><input id="h" inputmode="decimal" placeholder="مثلاً ۶۸" /></div>
      </div>
      <button class="btn" id="go" type="button">محاسبهٔ صدک</button>
    </form>
    <div id="out" class="result" aria-live="polite"><p class="text-muted">وزن یا قد (یا هر دو) را وارد کنید.</p></div>
  </div>
  <Fragment slot="interpret">
    <p>صدک بین <strong>۳ تا ۹۷</strong> معمولاً در محدودهٔ مورد انتظار است. صدک زیر ۳ یا بالای ۹۷ دلیلی برای بررسی بیشتر توسط پزشک است، نه تشخیص. یک اندازه‌گیری تنها کافی نیست؛ پزشک روند چند اندازه‌گیری، قد والدین، تغذیه و سلامت کلی کودک را با هم در نظر می‌گیرد.</p>
    <p>جدول مرجع را در مقالهٔ <a href="/blog/baby-weight-height-chart/">جدول وزن و قد نوزاد</a> ببینید و برای تفسیر بیشتر <a href="/blog/growth-percentile-explained/">صدک رشد چیست؟</a> را بخوانید.</p>
  </Fragment>
  <Fragment slot="how"><p>داده‌ها پارامترهای LMS منتشرشدهٔ «استانداردهای رشد کودک سازمان جهانی بهداشت (۲۰۰۶)» برای وزن برای سن و قد خوابیده برای سن (۰ تا ۲۴ ماه) هستند که مرکز CDC آمریکا نیز آن‌ها را بازنشر کرده است.</p></Fragment>
</Tool>
<script>
  import { differenceInCalendarDays } from 'date-fns-jalali';
  import { setupJalali, num, faN } from '../../lib/jalali-select';
  import { lmsAt, zScore, normCdf, valueAtZ } from '../../lib/growth';
  const get = setupJalali(document.getElementById('jd')!, 180, 3, 0);
  document.getElementById('go')!.onclick = () => {
    const out = document.getElementById('out')!;
    const sex = (document.getElementById('sex') as HTMLSelectElement).value as 'boys' | 'girls';
    const days = differenceInCalendarDays(new Date(), get());
    const months = days / 30.4375;
    if (days < 0) { out.innerHTML = '<p>تاریخ تولد در آینده است.</p>'; return; }
    if (months > 24.0) { out.innerHTML = '<p>این ابزار برای تولد تا ۲۴ ماهگی است. برای کودکان بزرگ‌تر از جدول‌های ۲ تا ۵ سال WHO استفاده کنید یا با پزشک مشورت کنید.</p>'; return; }
    const w = num(document.getElementById('w') as HTMLInputElement), h = num(document.getElementById('h') as HTMLInputElement);
    const rows: string[] = [];
    const line = (label: string, x: number, key: any, unit: string) => {
      const p = lmsAt(key, months); const z = zScore(x, p); const pc = normCdf(z) * 100;
      const pcTxt = pc < 0.1 ? 'کمتر از ۰٫۱' : pc > 99.9 ? 'بیشتر از ۹۹٫۹' : faN(pc, 1);
      const flag = pc < 3 ? '<span class="chip !bg-pom-soft !text-pom-dark">زیر صدک ۳ – با پزشک مشورت کنید</span>' : pc > 97 ? '<span class="chip !bg-pom-soft !text-pom-dark">بالای صدک ۹۷ – با پزشک مشورت کنید</span>' : '<span class="chip !bg-teal-soft !text-teal">در محدودهٔ مورد انتظار</span>';
      rows.push(`<div class="mt-3"><p class="text-sm text-muted">${label}: ${faN(x, 2)} ${unit}</p><p class="stat">صدک ${pcTxt}</p><p class="text-sm">امتیاز Z: ${faN(z, 2)} · میانهٔ WHO: ${faN(p.M, 1)} ${unit} · محدودهٔ صدک ۳ تا ۹۷: ${faN(valueAtZ(-1.881, p), 1)} تا ${faN(valueAtZ(1.881, p), 1)}</p>${flag}</div>`);
    };
    if (w > 0.5 && w < 30) line('وزن برای سن', w, `${sex}_weight`, 'کیلوگرم');
    if (h > 30 && h < 120) line('قد برای سن', h, `${sex}_length`, 'سانتی‌متر');
    out.innerHTML = rows.length ? `<p class="text-sm">سن: ${faN(months, 1)} ماه</p>${rows.join('')}` : '<p>لطفاً وزن (کیلوگرم) یا قد (سانتی‌متر) معتبر وارد کنید.</p>';
  };
</script>

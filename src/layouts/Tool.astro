---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import Products from '../components/Products.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Illustration from '../components/Illustration.astro';
interface Props { slug: string; icon: string; title: string; description: string; h1: string; intro: string; faq: { q: string; a: string }[]; howto: string[]; products: { name: string; query: string; note: string }[]; related: { href: string; label: string }[]; category?: string }
const p = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const updated = '2026-10-16';
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: p.h1, url, applicationCategory: p.category ?? 'HealthApplication', operatingSystem: 'All', inLanguage: 'fa-IR', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'IRR' }, description: p.description },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: p.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'HowTo', name: `روش کار ${p.h1}`, inLanguage: 'fa-IR', step: p.howto.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, text: s })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: 'ماماگل', item: new URL('/', Astro.site).toString() }, { '@type': 'ListItem', position: 2, name: 'ابزارها', item: new URL('/tools/', Astro.site).toString() }, { '@type': 'ListItem', position: 3, name: p.h1, item: url } ] },
];
---
<Base title={p.title} description={p.description} schema={schema}>
  <div class="bg-gradient-to-b from-pom-soft/60 to-cream">
    <div class="wrap pt-6 pb-4">
      <Breadcrumbs items={[{ name: 'خانه', href: '/' }, { name: 'ابزارها', href: '/tools/' }, { name: p.h1, href: '' }]} />
      <div class="flex items-center gap-4">
        <Illustration name={p.icon} class="w-14 h-14 shrink-0" />
        <h1 class="text-2xl md:text-3xl font-black text-ink leading-snug">{p.h1}</h1>
      </div>
      <p class="mt-2 text-muted max-w-3xl">{p.intro}</p>
    </div>
  </div>
  <div class="wrap">
    <section class="card p-5 md:p-7 -mt-1" aria-label="ابزار"><slot /></section>
    <section class="prose my-10"><h2>تفسیر نتیجه</h2><slot name="interpret" /></section>
    <section class="prose my-10"><h2>این ابزار چطور محاسبه می‌کند؟</h2><slot name="how" />
      <ol>{p.howto.map((s) => <li>{s}</li>)}</ol></section>
    <Products items={p.products} placement={p.slug} />
    <Faq items={p.faq} />
    <RelatedLinks title="ابزارها و مقاله‌های مرتبط" links={p.related} />
    <p class="text-sm text-muted">آخرین به‌روزرسانی: <time datetime={updated}>۲۴ مهر ۱۴۰۵</time> · بازبینی محتوایی: تیم تحریریهٔ ماماگل (<a href="/editorial-policy/">سیاست محتوایی</a>)</p>
    <Disclaimer />
  </div>
</Base>
